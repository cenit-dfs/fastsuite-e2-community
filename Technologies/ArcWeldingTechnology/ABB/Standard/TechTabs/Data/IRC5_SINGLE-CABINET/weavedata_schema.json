{
  "version": "1.0",
  "data_type": "weavedata",
  "rapid_type": "weavedata",
  "rapid_template": "LOCAL PERS {rapid_type} {name}:=[{values}];",
  "fields": [
    {
      "name": "weave_shape",
      "type": "Integer",
      "output_index": 0,
      "default": 1,
      "min": 0,
      "max": 10,
      "description": "Weave shape pattern"
    },
    {
      "name": "weave_type",
      "type": "Integer",
      "output_index": 1,
      "default": 0,
      "min": 0,
      "max": 10,
      "description": "Weave type"
    },
    {
      "name": "weave_length",
      "type": "Integer",
      "output_index": 2,
      "default": 4,
      "min": 0,
      "max": 100,
      "description": "Weave length (mm)"
    },
    {
      "name": "weave_width",
      "type": "Integer",
      "output_index": 3,
      "default": 5,
      "min": 0,
      "max": 100,
      "description": "Weave width (mm)"
    },
    {
      "name": "weave_height",
      "type": "Integer",
      "output_index": 4,
      "default": 0,
      "min": 0,
      "max": 100,
      "description": "Weave height (mm)"
    },
    {
      "name": "dwell_left",
      "type": "Integer",
      "output_index": 5,
      "default": 0,
      "min": 0,
      "max": 9999,
      "description": "Dwell left (ms)"
    },
    {
      "name": "dwell_center",
      "type": "Integer",
      "output_index": 6,
      "default": 0,
      "min": 0,
      "max": 9999,
      "description": "Dwell center (ms)"
    },
    {
      "name": "dwell_right",
      "type": "Integer",
      "output_index": 7,
      "default": 0,
      "min": 0,
      "max": 9999,
      "description": "Dwell right (ms)"
    },
    {
      "name": "weave_dir",
      "type": "Integer",
      "output_index": 8,
      "default": 0,
      "min": 0,
      "max": 360,
      "description": "Weave direction (degrees)"
    },
    {
      "name": "weave_tilt",
      "type": "Integer",
      "output_index": 9,
      "default": 0,
      "min": -180,
      "max": 180,
      "description": "Weave tilt (degrees)"
    },
    {
      "name": "weave_ori",
      "type": "Integer",
      "output_index": 10,
      "default": 0,
      "min": 0,
      "max": 360,
      "description": "Weave orientation (degrees)"
    },
    {
      "name": "weave_bias",
      "type": "Integer",
      "output_index": 11,
      "default": 0,
      "min": -100,
      "max": 100,
      "description": "Weave bias (mm)"
    },
    {
      "name": "org_weave_width",
      "type": "Integer",
      "output_index": 12,
      "default": 0,
      "min": 0,
      "max": 100,
      "description": "Original weave width (mm)"
    },
    {
      "name": "org_weave_height",
      "type": "Integer",
      "output_index": 13,
      "default": 0,
      "min": 0,
      "max": 100,
      "description": "Original weave height (mm)"
    },
    {
      "name": "org_weave_bias",
      "type": "Integer",
      "output_index": 14,
      "default": 0,
      "min": -100,
      "max": 100,
      "description": "Original weave bias (mm)"
    }
  ]
}
