{
  "version": "1.0",
  "data_type": "machineprocess",
  "rapid_type": "MachineProcess",
  "rapid_template": "LOCAL PERS {rapid_type} {name}:=[{values}];",
  "fields": [
    {
      "name": "EngageDistance",
      "type": "Double",
      "output_index": 0,
      "default": 0.0,
      "min": 0.0,
      "decimals": 1,
      "description": "Engage distance before process start (mm)"
    },
    {
      "name": "TiltAngle",
      "type": "Double",
      "output_index": 1,
      "default": 0.0,
      "decimals": 1,
      "description": "Tool tilt angle (deg)"
    },
    {
      "name": "LeadAngle",
      "type": "Double",
      "output_index": 2,
      "default": 0.0,
      "decimals": 1,
      "description": "Tool lead angle (deg)"
    },
    {
      "name": "PreRoutine",
      "type": "String",
      "output_index": 3,
      "default": "",
      "description": "RAPID routine called before process"
    },
    {
      "name": "PostRoutine",
      "type": "String",
      "output_index": 4,
      "default": "",
      "description": "RAPID routine called after process"
    }
  ]
}
